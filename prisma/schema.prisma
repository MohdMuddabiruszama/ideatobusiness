generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  COORDINATOR
}

enum BusinessStage {
  IDEA
  NEW_BUSINESS
  EXISTING_BUSINESS
}

enum EnquiryStatus {
  NEW
  CONTACTED
  QUALIFIED
  QUOTATION_SENT
  CONVERTED
  LOST
  ARCHIVED
}

enum ContactMethod {
  EMAIL
  PHONE
  WHATSAPP
  ANY
}

model AdminUser {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  name         String
  role         AdminRole      @default(ADMIN)
  isActive     Boolean        @default(true)
  mfaSecret    String?
  mfaEnabled   Boolean        @default(false)
  lastLoginAt  DateTime?
  sessions     AdminSession[]
  notes        EnquiryNote[]
  assignedTo   Enquiry[]
  auditLogs    AuditLog[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([email])
  @@index([role])
}

model AdminSession {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
}

model Enquiry {
  id                   String         @id @default(cuid())
  referenceId          String?        @unique
  fullName             String
  email                String
  phone                String
  businessStage        BusinessStage  @default(IDEA)
  departmentSlug       String
  serviceSlug          String?
  packageSlug          String?
  businessName         String?
  city                 String?
  country              String?
  message              String
  preferredContact     ContactMethod  @default(ANY)
  consentAccepted      Boolean        @default(true)
  privacyNoticeVersion String?        @default("1.0")
  sourcePath           String?
  status               EnquiryStatus  @default(NEW)
  assignedToId         String?
  assignedTo           AdminUser?     @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  isArchived           Boolean        @default(false)
  notes                EnquiryNote[]
  emailSent            Boolean        @default(false)
  teamNotified         Boolean        @default(false)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([email])
  @@index([phone])
  @@index([departmentSlug])
  @@index([isArchived])
}

model EnquiryNote {
  id         String   @id @default(cuid())
  enquiryId  String
  enquiry    Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  authorId   String
  author     AdminUser @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorName String
  content    String
  createdAt  DateTime @default(now())

  @@index([enquiryId])
  @@index([createdAt])
}

model ServiceDepartment {
  id               String    @id @default(cuid())
  slug             String    @unique
  name             String
  shortDescription String
  description      String
  iconName         String
  accentColor      String
  displayOrder     Int       @default(0)
  services         Service[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([slug])
}

model Service {
  id                      String            @id @default(cuid())
  slug                    String            @unique
  departmentId            String
  department              ServiceDepartment @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  departmentSlug          String
  name                    String
  tagline                 String
  description             String
  startingPrice           Int?
  priceDisplay            String            @default("Request Quote")
  isStartingPriceEstimate Boolean           @default(false)
  isQuotationRequired     Boolean           @default(false)
  isActive                Boolean           @default(true)
  displayOrder            Int               @default(0)
  whoIsItFor              Json?
  problemSolved           String?
  inclusions              Json?
  requirements            Json?
  deliveryProcess         Json?
  iconName                String            @default("Layers")
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  @@index([departmentSlug])
  @@index([departmentId])
  @@index([isActive])
}

model AuditLog {
  id           String     @id @default(cuid())
  adminUserId  String?
  adminUser    AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  adminEmail   String
  action       String
  resourceType String
  resourceId   String?
  details      Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime   @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([resourceType])
  @@index([adminUserId])
}

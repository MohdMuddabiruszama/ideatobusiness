generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BusinessStage {
  IDEA
  NEW_BUSINESS
  EXISTING_BUSINESS
}

enum EnquiryStatus {
  NEW
  CONTACTED
  QUALIFIED
  QUOTED
  CONVERTED
  NOT_CONVERTED
  CLOSED
}

enum ContactMethod {
  EMAIL
  PHONE
  WHATSAPP
  ANY
}

model Enquiry {
  id                   String         @id @default(cuid())
  fullName             String
  email                String
  phone                String
  businessStage        BusinessStage
  departmentSlug       String
  serviceSlug          String?
  packageSlug          String?
  businessName         String?
  city                 String?
  country              String?
  message              String
  preferredContact     ContactMethod  @default(ANY)
  consentAccepted      Boolean
  privacyNoticeVersion String?        @default("1.0")
  sourcePath           String?
  status               EnquiryStatus  @default(NEW)
  assignedTo           String?
  internalNotes        String?
  emailSent            Boolean        @default(false)
  teamNotified         Boolean        @default(false)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([email])
  @@index([departmentSlug])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}


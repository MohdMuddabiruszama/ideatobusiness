# Application Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="IDEATOBUSINESS"

# Database (PostgreSQL / Neon)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-1.aws.neon.tech/ideatobusiness?sslmode=require"

# Email Delivery (Resend API)
RESEND_API_KEY="re_sample_123456789"
NOTIFICATION_EMAIL_TO="team@ideatobusiness.com"
NOTIFICATION_EMAIL_FROM="IDEATOBUSINESS <notifications@ideatobusiness.com>"

# Admin Access Credentials (for Lead Management)
ADMIN_EMAIL="admin@ideatobusiness.com"
ADMIN_PASSWORD_HASH="$2b$10$SampleHashedPasswordForAdminAuth123456789"
ADMIN_JWT_SECRET="super-secret-jwt-key-replace-in-production-min-32-chars"

# Rate Limiting & Security (Upstash Redis for edge rate limiting - Optional fallback to in-memory)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Analytics (Optional)
NEXT_PUBLIC_GA_ID=""

